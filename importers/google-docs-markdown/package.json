{
  "name": "@raven/importer-google-docs-markdown",
  "version": "0.1.0",
  "description": "Imports Google Docs markdown exports into Raven",
  "private": true,
  "license": "BSD-3-Clause",
  "type": "module",
  "exports": {
    ".": {
      "@raven/backend-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "imports": {
    "#src/*": {
      "@raven/backend-source": "./src/*",
      "default": "./dist/*"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write . --log-level=warn",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "lint:fix": "eslint --fix && pnpm format",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.root.json"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@raven/core-import-format": "workspace:^"
  },
  "devDependencies": {
    "@raven/core-import-format": "workspace:*",
    "@raven/eslint-config": "workspace:*",
    "@types/mdast": "^4.0.4",
    "@types/node": "catalog:",
    "@types/turndown": "^5.0.6",
    "@types/unist": "^3.0.3",
    "eslint": "catalog:",
    "mdast-util-directive": "^3.1.1",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "unist": "^0.0.1",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@raven/core-myst-renderer": "workspace:*",
    "github-slugger": "^2.0.0",
    "linkedom": "^0.18.13",
    "mdast": "^3.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "turndown": "^7.2.4",
    "ulid": "^3.0.2",
    "unified": "^11.0.5",
    "unist-util-to-string-with-nodes": "^0.1.1",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3"
  }
}
