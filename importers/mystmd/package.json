{
  "name": "@raven/importer-mystmd",
  "version": "0.1.0",
  "description": "Imports MyST Markdown documents into Raven",
  "private": true,
  "license": "BSD-3-Clause",
  "type": "module",
  "exports": {
    ".": {
      "@raven/backend-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "imports": {
    "#src/*": {
      "@raven/backend-source": "./src/*",
      "default": "./dist/*"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write . --log-level=warn",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "lint:fix": "eslint --fix && pnpm format",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.root.json"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@raven/core-import-format": "workspace:^"
  },
  "devDependencies": {
    "@raven/core-import-format": "workspace:*",
    "@raven/eslint-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "myst-common": "1.10.1",
    "myst-frontmatter": "1.10.1",
    "myst-parser": "catalog:",
    "myst-transforms": "1.3.51",
    "vfile": "^5.3.7"
  }
}
