{
  "name": "@raven/core-myst-renderer",
  "version": "1.0.0",
  "license": "BSD-3-Clause",
  "description": "MyST markdown renderer for The Stacks",
  "type": "module",
  "exports": {
    ".": {
      "@raven/backend-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "format": "prettier --write . --log-level=warn",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "lint:fix": "eslint --fix && pnpm format",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.root.json"
  },
  "dependencies": {
    "hast": "^1.0.0",
    "hastscript": "^9.0.1",
    "mdast": "^3.0.0",
    "rehype-external-links": "^3.0.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-heading-id": "^1.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tiny-invariant": "^1.3.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@raven/eslint-config": "workspace:*",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.14.0",
    "@types/remark-heading-id": "^1.0.0",
    "@types/unist": "^3.0.3",
    "eslint": "catalog:",
    "hast-util-from-html": "^2.0.3",
    "prettier": "catalog:",
    "typescript": "^5.5.0",
    "typescript-eslint": "catalog:",
    "vitest": "^4.0.18"
  }
}
