{
  "name": "@raven/cli",
  "version": "0.1.0",
  "description": "raven: command-line interface for the Raven backend",
  "private": true,
  "license": "BSD-3-Clause",
  "type": "module",
  "bin": {
    "raven": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "imports": {
    "#package.json": "./package.json",
    "#src/*": "./src/*"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/index.ts",
    "format": "prettier --write . --log-level=warn",
    "format:check": "prettier --check .",
    "generate:api": "tsx scripts/generate-api.ts",
    "lint": "eslint",
    "lint:fix": "eslint --fix && pnpm format",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.root.json"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@commander-js/extra-typings": "^15.0.0",
    "@napi-rs/keyring": "^2.1.0",
    "commander": "^15.0.0",
    "env-paths": "^4.0.0",
    "hast-util-from-html": "catalog:",
    "js-yaml": "catalog:",
    "myst-ext-button": "catalog:",
    "myst-ext-card": "catalog:",
    "myst-ext-exercise": "catalog:",
    "myst-ext-grid": "catalog:",
    "myst-ext-proof": "catalog:",
    "myst-ext-tabs": "catalog:",
    "myst-frontmatter": "1.10.1",
    "myst-parser": "catalog:",
    "open": "^11.0.4",
    "openapi-fetch": "^0.17.0",
    "smol-toml": "catalog:",
    "ulid": "^3.0.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@raven/eslint-config": "workspace:*",
    "@types/js-yaml": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "openapi-typescript": "^7.13.0",
    "prettier": "catalog:",
    "tsdown": "^0.23.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
