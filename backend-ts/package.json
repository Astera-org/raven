{
  "name": "@raven/backend-ts",
  "version": "0.1.0",
  "license": "BSD-3-Clause",
  "description": "Raven backend — TypeScript rewrite",
  "type": "module",
  "exports": {
    ".": {
      "@raven/backend-source": "./src/app.ts",
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "import": "./dist/migrate.js"
    },
    "./types": {
      "types": "./src/api-v1/routes/types/index.ts",
      "import": "./dist/api-v1/routes/types/index.js"
    }
  },
  "imports": {
    "#src/*": {
      "@raven/backend-source": "./src/*",
      "default": "./dist/*"
    },
    "#v0/*": {
      "@raven/backend-source": "./src/api-v0/*",
      "default": "./dist/api-v0/*"
    },
    "#v1/*": {
      "@raven/backend-source": "./src/api-v1/*",
      "default": "./dist/api-v1/*"
    }
  },
  "scripts": {
    "ba:generate": "pnpm build && npx @better-auth/cli generate --config src/lib/auth.generate-config.ts",
    "backfill:reference-case": "tsx --conditions=@raven/backend-source src/scripts/backfill-reference-case.ts",
    "build": "rimraf dist && tsc",
    "db:check-migrations": "pnpm db:generate && if [ -n \"$(git status --porcelain -- drizzle/migrations)\" ]; then echo 'Running db:generate produced migration changes that are not committed. Review the schema changes, then commit any required generated migrations.' >&2; git status --porcelain -- drizzle/migrations >&2; exit 1; fi",
    "db:generate": "drizzle-kit generate",
    "db:introspect": "drizzle-kit introspect",
    "db:migrate": "tsx --conditions=@raven/backend-source src/migrate.ts",
    "db:push": "drizzle-kit push",
    "dev": "TZ=UTC node src/scripts/dev.ts",
    "format": "prettier --write . --log-level=warn",
    "format:check": "prettier --check .",
    "generate:mdast-fixtures": "tsx --conditions=@raven/backend-source src/scripts/generate-mdast-fixtures.ts",
    "linear:team-info": "tsx --conditions=@raven/backend-source src/scripts/linear-team-info.ts",
    "lint": "eslint",
    "lint:fix": "eslint --fix && pnpm format",
    "precommit": "pnpm typecheck && pnpm lint && pnpm format:check",
    "seed:admin": "tsx --conditions=@raven/backend-source src/scripts/seed-admin.ts",
    "seed:test-user": "tsx --conditions=@raven/backend-source src/scripts/seed-test-user.ts",
    "semgrep": "semgrep scan --config ../.semgrep/ src/ --error --config=r/typescript --config=r/owasp-top-10",
    "start": "TZ=UTC node dist/index.js",
    "test": "TZ=UTC vitest run",
    "test:coverage": "TZ=UTC vitest run --coverage",
    "test:ui": "TZ=UTC vitest --ui",
    "test:ui:coverage": "TZ=UTC vitest --ui --coverage",
    "test:watch": "TZ=UTC vitest",
    "typecheck": "rimraf dist && tsc --noEmit -p tests/tsconfig.json && tsc --noEmit -p tsconfig.root.json",
    "v1:contract": "tsx --conditions=@raven/backend-source src/scripts/v1-api-contract.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.717.0",
    "@aws-sdk/client-sqs": "^3.717.0",
    "@aws-sdk/s3-request-presigner": "^3.717.0",
    "@citation-js/core": "0.9.0",
    "@citation-js/plugin-bibtex": "0.9.0",
    "@hapi/accept": "^6.0.3",
    "@hono/node-server": "^2.1.6",
    "@hono/zod-openapi": "^1.6.1",
    "@raven/core-import-format": "workspace:*",
    "@raven/importer-google-docs-markdown": "workspace:*",
    "@raven/importer-mystmd": "workspace:*",
    "@scalar/hono-api-reference": "^0.12.0",
    "better-auth": "^1.6.20",
    "change-case": "^5.4.4",
    "dayjs": "^1.11.21",
    "drizzle-orm": "^0.45.2",
    "file-type": "^22.1.1",
    "github-slugger": "^2.0.0",
    "hono": "catalog:",
    "is-svg": "^6.1.0",
    "jose": "^5.9.6",
    "js-yaml": "catalog:",
    "lru-cache": "^11.5.1",
    "mdast": "^3.0.0",
    "mysql2": "catalog:",
    "myst-common": "1.10.1",
    "myst-ext-button": "catalog:",
    "myst-ext-card": "catalog:",
    "myst-ext-exercise": "catalog:",
    "myst-ext-grid": "catalog:",
    "myst-ext-proof": "catalog:",
    "myst-ext-tabs": "catalog:",
    "myst-frontmatter": "1.10.1",
    "myst-migrate": "1.11.0",
    "myst-parser": "catalog:",
    "myst-transforms": "1.3.51",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.1",
    "pino": "^9.0.0",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "sharp": "^0.35.5",
    "smol-toml": "catalog:",
    "strip-markdown": "^6.0.0",
    "ulid": "^3.0.2",
    "unified": "^11.0.5",
    "unist-util-to-string-with-nodes": "^0.1.1",
    "unist-util-visit": "^5.1.0",
    "vfile": "^5.3.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@raven/eslint-config": "workspace:*",
    "@raven/eslint-rules": "workspace:*",
    "@types/js-yaml": "catalog:",
    "@types/mdast": "^4.0.4",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "3.2.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "catalog:",
    "openapi31-ts": "^1.0.0",
    "prettier": "catalog:",
    "rimraf": "^6.1.3",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
