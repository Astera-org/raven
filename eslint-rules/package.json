{
  "name": "@raven/eslint-rules",
  "version": "1.0.0",
  "description": "Custom ESLint rules for the Raven monorepo",
  "private": true,
  "license": "BSD-3-Clause",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "format": "prettier --write . --log-level=warn",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.root.json"
  },
  "devDependencies": {
    "@eslint/markdown": "catalog:",
    "@raven/eslint-config": "workspace:*",
    "@typescript-eslint/utils": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
