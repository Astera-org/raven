# Copy this file to .env and fill in the values for your local setup.
# .env is gitignored; .env.template is the only one that should be committed.

# Origin the admin-ui dev server runs on (see admin-ui/vite.config.ts server.port).
PLAYWRIGHT_BASE_URL=http://localhost:3003

# Backend API origin admin-ui's dev server proxies /api requests to.
VITE_BACKEND_URL=http://localhost:7001

# Credentials for a test admin account that must already exist (seeded) in the
# target database. Sign-in goes through BetterAuth (see e2e/utils.ts).
TEST_ADMIN_USERNAME=
TEST_ADMIN_PASSWORD=
