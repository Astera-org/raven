{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "#src/*": ["./*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": [
    "node_modules",
    "test-results",
    "playwright-report",
    "blob-report"
  ]
}
