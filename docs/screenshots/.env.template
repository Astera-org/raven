# Copy this file to .env. The defaults match docker-compose.yml.
# .env is gitignored; .env.template is the only one that should be committed.

# Origin the Stacks frontend dev server runs on. Must match BASE_URL_WEB in raven.toml.
STACKS_BASE_URL=http://localhost:3005

# Path to the thestacks.org frontend checkout, relative to this directory.
STACKS_FRONTEND_DIR=../../../thestacks.org/frontend

# Site admin, used only by shots/seed.setup.ts to create the org and membership.
SCREENSHOT_ADMIN_USERNAME=admin
SCREENSHOT_ADMIN_PASSWORD=admin_screenshots_password

# The account that appears in screenshots.
SCREENSHOT_USER_USERNAME=ada
SCREENSHOT_USER_PASSWORD=ada_screenshots_password

# Where `pnpm push-images` and `pnpm pull-images` sync the PNGs in out/: s3://<bucket>/docs-images/stacks/ and docs-images/raven/.
# Variables already set in the environment take precedence over these.
# Needs the AWS CLI v2 installed; DOCS_IMAGES_AWS_PROFILE is one of its profiles.
DOCS_IMAGES_AWS_PROFILE=
DOCS_IMAGES_S3_BUCKET=
